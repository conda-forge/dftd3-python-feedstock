From 92fd45aaa3a15b1ccd21783e6ce8610cd0e94892 Mon Sep 17 00:00:00 2001
From: "Lori A. Burns" <lori.burns@gmail.com>
Date: Sun, 11 Oct 2026 19:15:20 -0400
Subject: [PATCH 1/1] new conda python Windows layout

---
 python/dftd3/parameters.py | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/python/dftd3/parameters.py b/python/dftd3/parameters.py
index 479016d..3f252a9 100644
--- a/python/dftd3/parameters.py
+++ b/python/dftd3/parameters.py
@@ -54,6 +54,7 @@ def get_data_file_name(base_name: str = "parameters.toml") -> str:
     )
     if not exists(data_file):
         # for Windows install layout
+        # * conda py<315 at Lib/site-packages/dftd3/parameters.py
         data_file = join(
             dirname(__file__),
             "..",
@@ -65,7 +66,21 @@ def get_data_file_name(base_name: str = "parameters.toml") -> str:
             base_name,
         )
         if not exists(data_file):
-            data_file = join(dirname(__file__), base_name)
+            # for Windows install layout
+            # * conda py>=315 at lib/python/site-packages/dftd3/parameters.py
+            data_file = join(
+                dirname(__file__),
+                "..",
+                "..",
+                "..",
+                "..",
+                "Library",
+                "share",
+                "s-dftd3",
+                base_name,
+            )
+            if not exists(data_file):
+                data_file = join(dirname(__file__), base_name)
 
     return data_file
 
